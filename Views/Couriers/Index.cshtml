@model List<wt_lab4_4mvc_talko.Models.Courier>
@{
    ViewData["Title"] = "Курьеры";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">✦ Наши курьеры ✦</h1>
        <p class="lead">Быстрая и вежливая доставка — наша гордость</p>
        <div class="gold-divider"></div>
    </div>

    <div class="row">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow rounded text-center">
                    <div class="pt-4">
                        <img src="@c.ImageUrl"
                             alt="@c.FullName"
                             class="rounded-circle"
                             style="width: 140px; height: 140px; object-fit: cover; border: 3px solid #d4c5a9;">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@c.FullName</h5>
                        <p class="text-muted small mb-2">🚗 @c.Vehicle</p>

                        <div class="mb-3">
                            <span class="badge bg-secondary">⭐ @c.Rating</span>
                            <span class="badge bg-success">@c.DeliveriesCount доставок</span>
                        </div>

                        <p class="card-text small text-muted">@c.Description</p>

                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@c.Id"
                               class="btn btn-primary btn-sm">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>