@model List<wt_lab4_4mvc_talko.Models.Restaurant>
@{
    ViewData["Title"] = "Рестораны";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">✦ Наши рестораны ✦</h1>
        <p class="lead">Лучшие заведения города — доставка прямо к вашему столу</p>
        <div class="gold-divider"></div>
    </div>

    <div class="row">
        @foreach (var r in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow rounded">
                    <img src="@r.ImageUrl" class="card-img-top" alt="@r.Title">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@r.Title</h5>
                        <p class="card-text text-muted">@r.Description</p>

                        <div class="mb-2">
                            <span class="badge bg-secondary">⭐ @r.Rating</span>
                            <span class="badge bg-success">Открыт</span>
                        </div>

                        <p class="small mb-3">📍 @r.Address</p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@r.Id"
                               class="btn btn-primary btn-sm">Подробнее</a>
                            <a class="btn btn-outline-primary btn-sm" href="tel:@r.Phone">📞 Позвонить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>