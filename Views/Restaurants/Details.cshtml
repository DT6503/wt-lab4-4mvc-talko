@model wt_lab4_4mvc_talko.Models.Restaurant
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="card shadow rounded">
        <div class="row g-0">
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100"
                     style="object-fit: cover;" alt="@Model.Title">
            </div>
            <div class="col-md-7">
                <div class="card-body">
                    <h2 class="card-title">@Model.Title</h2>
                    <p class="text-muted">@Model.Description</p>
                    <p><span class="badge bg-secondary">⭐ @Model.Rating</span></p>
                    <p><strong>📍 Адрес:</strong> @Model.Address</p>
                    <p><strong>📞 Телефон:</strong> @Model.Phone</p>
                    <a asp-action="Index" class="btn btn-secondary">← Назад к ресторанам</a>
                </div>
            </div>
        </div>
    </div>
</div>