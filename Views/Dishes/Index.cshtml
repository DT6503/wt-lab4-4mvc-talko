@model List<wt_lab4_4mvc_talko.Models.Dish>
@{
    ViewData["Title"] = "Каталог блюд";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🍕 Каталог блюд</h1>
        <a asp-action="Create" class="btn btn-success">
            ➕ Добавить блюдо
        </a>
    </div>

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Все</a>
        @foreach (var cat in ViewBag.Categories as List<string> ?? new())
        {
            <a asp-action="Index" asp-route-category="@cat"
               class="btn btn-outline-primary btn-sm">@cat</a>
        }
    </div>

    <div class="row">
        @foreach (var dish in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow rounded">
                    <img src="@dish.ImageUrl" class="card-img-top" alt="@dish.Name">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@dish.Name</h5>
                        <p class="card-text text-muted">@dish.Description</p>

                        <div class="mb-2">
                            <span class="badge bg-secondary">@dish.Category</span>
                            @if (dish.IsAvailable)
                            {
                                <span class="badge bg-success">Доступно</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Нет в наличии</span>
                            }
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <strong class="fs-5">@dish.Price руб.</strong>
                            <div>
                                <a asp-action="Details" asp-route-id="@dish.Id"
                                   class="btn btn-primary btn-sm">Подробнее</a>
                                <a asp-action="Delete" asp-route-id="@dish.Id"
                                   class="btn btn-danger btn-sm">🗑️ Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>