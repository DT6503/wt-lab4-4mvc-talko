@{
    ViewData["Title"] = "Главная";  // заголовок вкладки razor
                                    //операции без вывода (присваивание, объявление переменных, вызовы методов) оборачивают в @{ ... }
                                    // если бы был вывод то можно было бы напистаь так @ViewData["Title"] = "Главная";
}

<div class="container mt-5">  <!-- контейнер бутстрапа + отступ сверху -->

    <h1>Доставка еды</h1>  <!-- заголовок -->

    <p>Каталог блюд с доставкой на дом.</p>  <!-- описание -->

    <a href="#" class="btn btn-primary">Каталог</a>  <!-- кнопка бутстрапа-->

</div>